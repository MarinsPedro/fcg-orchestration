# Non-secret environment configuration. Credentials are injected separately.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
Authentication__Issuer=fiap-cloud-games-identity
Authentication__Audience=payments-api
Authentication__RequireHttpsMetadata=false
Authentication__Authority=http://identity:8080
Authentication__MetadataAddress=http://identity:8080/.well-known/openid-configuration
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
FakePaymentProvider__ApprovalRate=90
RabbitMq__Topology__Exchanges__PaymentRequested=payments.payment-requested.v1
RabbitMq__Topology__Exchanges__PaymentApproved=payments.payment-approved.v1
RabbitMq__Topology__Exchanges__PaymentRejected=payments.payment-rejected.v1
RabbitMq__Topology__Queues__PaymentRequested=fcg-payments-payment-requested
Authentication__AllowedTokenUses__0=service
Authentication__ClockSkew=00:00:30
AllowedHosts=*
