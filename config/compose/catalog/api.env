# Configuracao completa e credenciais DEV da Catalog API.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Database=Host=postgres;Port=5432;Database=fcg_catalog;Username=postgres;Password=postgres
Authentication__Issuer=fiap-cloud-games-identity
Authentication__Audience=catalog-api
Authentication__RequireHttpsMetadata=false
Authentication__Authority=http://identity:8080
Authentication__AllowedTokenUses__0=service
Authentication__ClockSkew=00:00:30
AllowedHosts=*
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
