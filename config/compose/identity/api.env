# Configuracao completa e credenciais DEV da Identity API.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Database=Host=postgres;Port=5432;Database=fcg_identity;Username=postgres;Password=postgres
Jwt__Issuer=fiap-cloud-games-identity
Jwt__PrivateKeyPath=
Jwt__AllowEphemeralDevelopmentKey=true
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__Username=fcg
RabbitMq__Password=Fiap@123456
RabbitMq__VirtualHost=/
Messaging__UseInMemory=false
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Information
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning
Logging__LogLevel__FiapCloudGames.Identity=Debug
AllowedHosts=*
