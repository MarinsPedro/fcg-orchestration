# Configuracao completa e credenciais DEV da Orders API.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Database=Host=postgres;Port=5432;Database=fcg_orders;Username=postgres;Password=postgres
Authentication__Issuer=fiap-cloud-games-identity
Authentication__Audience=orders-api
Authentication__RequireHttpsMetadata=false
Authentication__Authority=http://identity:8080
Authentication__AllowedTokenUses__0=service
Authentication__ClockSkew=00:00:30
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__Username=fcg
RabbitMq__Password=Fiap@123456
RabbitMq__VirtualHost=/
ServiceAuthentication__Authority=http://identity:8080
ServiceAuthentication__TokenEndpoint=http://identity:8080/oauth2/token
ServiceAuthentication__ClientId=orders-api
ServiceAuthentication__ClientSecret=Fiap@123456
ServiceAuthentication__RequireHttps=false
ServiceAuthentication__RefreshBeforeExpiration=00:00:30
ServiceAuthentication__DiscoveryRefreshInterval=01:00:00
ServiceAuthentication__HttpTimeout=00:00:10
ServiceAuthentication__RetryCount=2
ServiceAuthentication__RetryBaseDelay=00:00:00.200
ServiceAuthentication__MaxCachedTokens=128
ServiceAuthentication__RequireSameHostForDiscoveredTokenEndpoint=true
CatalogApi__BaseAddress=http://catalog-api:8080/
CatalogApi__Audience=catalog-api
CatalogApi__Scopes=catalog.games.read
PromotionsApi__BaseAddress=http://promotions-api:8080/
PromotionsApi__Audience=promotions-api
PromotionsApi__Scopes=promotions.calculate promotions.campaigns.read
LibraryApi__BaseAddress=http://library-api:8080/
LibraryApi__Audience=library-api
LibraryApi__Scopes=library.ownership.read
RabbitMq__Topology__Exchanges__PurchaseOrderCreated=orders.purchase-order-created.v1
RabbitMq__Topology__Exchanges__PaymentRequested=payments.payment-requested.v1
RabbitMq__Topology__Exchanges__PaymentApproved=payments.payment-approved.v1
RabbitMq__Topology__Exchanges__PaymentRejected=payments.payment-rejected.v1
RabbitMq__Topology__Exchanges__GameGrantRequested=library.game-grant-requested.v1
RabbitMq__Topology__Exchanges__GameGranted=library.game-granted.v1
RabbitMq__Topology__Exchanges__OrderCompleted=orders.order-completed.v1
RabbitMq__Topology__Queues__PurchaseOrderSaga=fcg-orders-purchase-order-saga
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
AllowedHosts=*
