# Configuracao completa e credenciais DEV do Orders Worker.
DOTNET_ENVIRONMENT=Development
ConnectionStrings__Database=Host=postgres;Port=5432;Database=fcg_orders;Username=postgres;Password=postgres
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__Username=fcg
RabbitMq__Password=Fiap@123456
RabbitMq__VirtualHost=/
RabbitMq__Topology__Exchanges__PurchaseOrderCreated=orders.purchase-order-created.v1
RabbitMq__Topology__Exchanges__PaymentRequested=payments.payment-requested.v1
RabbitMq__Topology__Exchanges__PaymentApproved=payments.payment-approved.v1
RabbitMq__Topology__Exchanges__PaymentRejected=payments.payment-rejected.v1
RabbitMq__Topology__Exchanges__GameGrantRequested=library.game-grant-requested.v1
RabbitMq__Topology__Exchanges__GameGranted=library.game-granted.v1
RabbitMq__Topology__Exchanges__OrderCompleted=orders.order-completed.v1
RabbitMq__Topology__Queues__PurchaseOrderSaga=fcg-orders-purchase-order-saga
PurchaseOrderSaga__MissingInstanceRedeliveryIntervals__0=00:00:01
PurchaseOrderSaga__MissingInstanceRedeliveryIntervals__1=00:00:03
PurchaseOrderSaga__MissingInstanceRedeliveryIntervals__2=00:00:05
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information
