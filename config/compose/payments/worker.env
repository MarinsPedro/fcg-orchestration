# Configuracao completa e credenciais DEV do Payments Worker.
DOTNET_ENVIRONMENT=Development
ConnectionStrings__Database=Host=postgres;Port=5432;Database=fcg_payments;Username=postgres;Password=postgres
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__Username=fcg
RabbitMq__Password=Fiap@123456
RabbitMq__VirtualHost=/
FakePaymentProvider__ApprovalRate=90
Outbox__BatchSize=20
Outbox__PollingIntervalSeconds=2
RabbitMq__Topology__Exchanges__PaymentRequested=payments.payment-requested.v1
RabbitMq__Topology__Exchanges__PaymentApproved=payments.payment-approved.v1
RabbitMq__Topology__Exchanges__PaymentRejected=payments.payment-rejected.v1
RabbitMq__Topology__Queues__PaymentRequested=fcg-payments-payment-requested
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information
