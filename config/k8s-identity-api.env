# Non-secret environment configuration. Credentials are injected separately.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
Jwt__Issuer=fiap-cloud-games-identity
Jwt__PrivateKeyPath=
Jwt__AllowEphemeralDevelopmentKey=true
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
Messaging__UseInMemory=false
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Information
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning
Logging__LogLevel__FiapCloudGames.Identity=Debug
AllowedHosts=*
