# Non-secret environment configuration. Credentials are injected separately.
DOTNET_ENVIRONMENT=Development
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__Topology__Exchanges__GameGrantRequested=library.game-grant-requested.v1
RabbitMq__Topology__Exchanges__GameGranted=library.game-granted.v1
RabbitMq__Topology__Queues__GameGrantRequested=fcg-library-game-grant-requested
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__MassTransit=Information
