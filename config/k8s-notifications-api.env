# Non-secret values. Passwords are injected through runtime env / K8s Secrets.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
Authentication__Authority=http://identity-api:8080
Authentication__Issuer=fiap-cloud-games-identity
Authentication__Audience=notifications-api
Authentication__RequireHttpsMetadata=false
Authentication__AllowedTokenUses__0=service
Authentication__ClockSkew=00:00:30
AllowedHosts=*
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
