# Non-secret values, Worker with five MassTransit consumers.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
RabbitMq__Host=rabbitmq
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__Topology__Exchanges__UserCreated=identity.user-created.v1
RabbitMq__Topology__Exchanges__PaymentApproved=payments.payment-approved.v1
RabbitMq__Topology__Exchanges__PaymentRejected=payments.payment-rejected.v1
RabbitMq__Topology__Exchanges__OrderCompleted=orders.order-completed.v1
RabbitMq__Topology__Exchanges__OrderFailed=orders.order-failed.v1
RabbitMq__Topology__Queues__UserCreated=notifications.user-created
RabbitMq__Topology__Queues__PaymentApproved=notifications.payment-approved
RabbitMq__Topology__Queues__PaymentRejected=notifications.payment-rejected
RabbitMq__Topology__Queues__OrderCompleted=notifications.order-completed
RabbitMq__Topology__Queues__OrderFailed=notifications.order-failed
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning
Logging__LogLevel__MassTransit=Information
